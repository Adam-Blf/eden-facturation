# eden-facturation, variables d'environnement
# Copier en .env.local (gitignored). Ne jamais committer de vraie valeur.
# En production, renseigner les Environment Variables du projet Vercel.
# En local, next.config.ts charge aussi ~/.secrets/projets.env s'il existe
# (ou le fichier de CENTRAL_ENV_FILE), sans ecraser une variable deja posee.
# Les cles propres au projet portent le prefixe EDEN pour rester uniques.

# URL publique de l'application (liens de retour Stripe, redirection d'auth)
NEXT_PUBLIC_EDEN_APP_URL=https://facturation.beloucif.com

# Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_EDEN_SUPABASE_URL=
NEXT_PUBLIC_EDEN_SUPABASE_ANON_KEY=
# Cle service_role, serveur seulement (webhook Stripe), contourne la RLS
EDEN_SUPABASE_SERVICE_ROLE_KEY=

# Stripe (abonnements)
EDEN_STRIPE_SECRET_KEY=
EDEN_STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_UNLIMITED=
